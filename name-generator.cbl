>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. NAME-GENERATOR.
AUTHOR. JOSHUAGOX-AND-CONTRIBUTORS.
DATE-WRITTEN. 2026-09-28.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ADJ-IN-FILE ASSIGN TO WS-ADJ-FILE
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-ADJ-STATUS.

    SELECT NOUN-IN-FILE ASSIGN TO WS-NOUN-FILE
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-NOUN-STATUS.

    SELECT TMP-FILE ASSIGN TO WS-TMP-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-TMP-STATUS.

DATA DIVISION.
FILE SECTION.
FD  ADJ-IN-FILE.
01  ADJ-RECORD PIC X(128).

FD  NOUN-IN-FILE.
01  NOUN-RECORD PIC X(128).

FD  TMP-FILE.
01  TMP-RECORD PIC X(256).

WORKING-STORAGE SECTION.
01  WS-ADJ-STATUS      PIC XX VALUE "00".
01  WS-NOUN-STATUS     PIC XX VALUE "00".
01  WS-TMP-STATUS      PIC XX VALUE "00".
01  WS-EOF             PIC X VALUE 'N'.

01  WS-ADJ-FILE        PIC X(256) VALUE SPACES.
01  WS-NOUN-FILE       PIC X(256) VALUE SPACES.
01  WS-ADJ-FOLDER      PIC X(256) VALUE SPACES.
01  WS-NOUN-FOLDER     PIC X(256) VALUE SPACES.
01  WS-SEPARATOR       PIC X(32) VALUE "-".
01  WS-COUNTO-STR      PIC X(32) VALUE SPACES.
01  WS-COUNTO          PIC 9(7) VALUE 1.
01  WS-DEBUG-STR       PIC X(10) VALUE SPACES.
01  WS-TMP-PATH        PIC X(256) VALUE SPACES.
01  WS-CMD             PIC X(512) VALUE SPACES.
01  WS-SYS-RET         PIC S9(9) BINARY VALUE 0.

01  WS-PID             PIC 9(9) BINARY VALUE 0.
01  WS-PID-DISP        PIC 9(9) VALUE 0.
01  WS-TIME            PIC 9(8) VALUE 0.
01  WS-SEED            PIC 9(9) BINARY VALUE 0.
01  WS-DUMMY-FLOAT     USAGE FLOAT-LONG.

01  WS-NUM-ADJS        PIC 9(7) BINARY VALUE 0.
01  WS-NUM-NOUNS       PIC 9(7) BINARY VALUE 0.
01  WS-I               PIC 9(7) BINARY VALUE 0.
01  WS-I-MINUS-ONE     PIC 9(7) VALUE 0.
01  WS-ADJ-IDX         PIC 9(7) BINARY VALUE 0.
01  WS-NOUN-IDX        PIC 9(7) BINARY VALUE 0.
01  WS-OUTPUT-LINE     PIC X(256) VALUE SPACES.

01  ADJ-TABLE.
    05 ADJ-ITEM PIC X(64) OCCURS 40000 TIMES.

01  NOUN-TABLE.
    05 NOUN-ITEM PIC X(64) OCCURS 40000 TIMES.

PROCEDURE DIVISION.
MAIN-PROCEDURE.
    PERFORM INIT-ENV
    PERFORM INIT-RANDOM
    PERFORM RESOLVE-FILES
    PERFORM LOAD-WORDS
    PERFORM GENERATE-NAMES
    MOVE 0 TO RETURN-CODE
    STOP RUN RETURNING 0.

INIT-ENV.
    CALL "signal" USING BY VALUE 13, BY VALUE 1

    ACCEPT WS-SEPARATOR FROM ENVIRONMENT "SEPARATOR"
    IF WS-SEPARATOR = SPACES
        MOVE "-" TO WS-SEPARATOR
    END-IF

    ACCEPT WS-NOUN-FOLDER FROM ENVIRONMENT "NOUN_FOLDER"
    IF WS-NOUN-FOLDER = SPACES
        MOVE "nouns" TO WS-NOUN-FOLDER
    END-IF

    ACCEPT WS-ADJ-FOLDER FROM ENVIRONMENT "ADJ_FOLDER"
    IF WS-ADJ-FOLDER = SPACES
        MOVE "adjectives" TO WS-ADJ-FOLDER
    END-IF

    ACCEPT WS-NOUN-FILE FROM ENVIRONMENT "NOUN_FILE"
    ACCEPT WS-ADJ-FILE FROM ENVIRONMENT "ADJ_FILE"

    ACCEPT WS-COUNTO-STR FROM ENVIRONMENT "counto"
    IF WS-COUNTO-STR NOT = SPACES
        MOVE FUNCTION NUMVAL(WS-COUNTO-STR) TO WS-COUNTO
    ELSE
        CALL "getpid" RETURNING WS-PID
        MOVE WS-PID TO WS-PID-DISP
        STRING "/tmp/namgen_tput_" WS-PID-DISP ".tmp" DELIMITED BY SIZE INTO WS-TMP-PATH
        STRING "tput lines 2>/dev/null > " FUNCTION TRIM(WS-TMP-PATH) X"00" DELIMITED BY SIZE INTO WS-CMD
        CALL "system" USING WS-CMD RETURNING WS-SYS-RET
        OPEN INPUT TMP-FILE
        IF WS-TMP-STATUS = "00"
            READ TMP-FILE INTO WS-COUNTO-STR
            CLOSE TMP-FILE
            IF WS-COUNTO-STR NOT = SPACES
                MOVE FUNCTION NUMVAL(WS-COUNTO-STR) TO WS-COUNTO
            END-IF
        END-IF
        STRING "rm -f " FUNCTION TRIM(WS-TMP-PATH) X"00" DELIMITED BY SIZE INTO WS-CMD
        CALL "system" USING WS-CMD RETURNING WS-SYS-RET
        IF WS-COUNTO <= 0
            MOVE 24 TO WS-COUNTO
        END-IF
    END-IF

    ACCEPT WS-DEBUG-STR FROM ENVIRONMENT "DEBUG"
    .

INIT-RANDOM.
    CALL "getpid" RETURNING WS-PID
    ACCEPT WS-TIME FROM TIME
    COMPUTE WS-SEED = WS-TIME + WS-PID
    COMPUTE WS-DUMMY-FLOAT = FUNCTION RANDOM(WS-SEED)
    .

RESOLVE-FILES.
    CALL "getpid" RETURNING WS-PID
    MOVE WS-PID TO WS-PID-DISP

    IF WS-NOUN-FILE = SPACES
        STRING "/tmp/namgen_cob_n_" WS-PID-DISP ".tmp" DELIMITED BY SIZE INTO WS-TMP-PATH
        STRING "find """ FUNCTION TRIM(WS-NOUN-FOLDER) """ -maxdepth 1 -type f 2>/dev/null | shuf -n 1 > " FUNCTION TRIM(WS-TMP-PATH) X"00" DELIMITED BY SIZE INTO WS-CMD
        CALL "system" USING WS-CMD RETURNING WS-SYS-RET
        OPEN INPUT TMP-FILE
        IF WS-TMP-STATUS = "00"
            READ TMP-FILE INTO WS-NOUN-FILE
            CLOSE TMP-FILE
        END-IF
        STRING "rm -f " FUNCTION TRIM(WS-TMP-PATH) X"00" DELIMITED BY SIZE INTO WS-CMD
        CALL "system" USING WS-CMD RETURNING WS-SYS-RET
        IF WS-NOUN-FILE = SPACES
            STRING FUNCTION TRIM(WS-NOUN-FOLDER) "/nouns.txt" DELIMITED BY SIZE INTO WS-NOUN-FILE
        END-IF
    END-IF

    IF WS-ADJ-FILE = SPACES
        STRING "/tmp/namgen_cob_a_" WS-PID-DISP ".tmp" DELIMITED BY SIZE INTO WS-TMP-PATH
        STRING "find """ FUNCTION TRIM(WS-ADJ-FOLDER) """ -maxdepth 1 -type f 2>/dev/null | shuf -n 1 > " FUNCTION TRIM(WS-TMP-PATH) X"00" DELIMITED BY SIZE INTO WS-CMD
        CALL "system" USING WS-CMD RETURNING WS-SYS-RET
        OPEN INPUT TMP-FILE
        IF WS-TMP-STATUS = "00"
            READ TMP-FILE INTO WS-ADJ-FILE
            CLOSE TMP-FILE
        END-IF
        STRING "rm -f " FUNCTION TRIM(WS-TMP-PATH) X"00" DELIMITED BY SIZE INTO WS-CMD
        CALL "system" USING WS-CMD RETURNING WS-SYS-RET
        IF WS-ADJ-FILE = SPACES
            STRING FUNCTION TRIM(WS-ADJ-FOLDER) "/adjectives.txt" DELIMITED BY SIZE INTO WS-ADJ-FILE
        END-IF
    END-IF
    .

LOAD-WORDS.
    MOVE "00" TO WS-ADJ-STATUS
    MOVE "00" TO WS-NOUN-STATUS
    MOVE 'N' TO WS-EOF
    MOVE 0 TO WS-NUM-ADJS

    OPEN INPUT ADJ-IN-FILE
    IF WS-ADJ-STATUS NOT = "00"
        DISPLAY "Error opening adjective file: " FUNCTION TRIM(WS-ADJ-FILE) UPON SYSERR
        STOP RUN RETURNING 1
    END-IF

    PERFORM UNTIL WS-EOF = 'Y' OR WS-NUM-ADJS >= 40000
        READ ADJ-IN-FILE
            AT END
                MOVE 'Y' TO WS-EOF
            NOT AT END
                IF ADJ-RECORD NOT = SPACES
                    ADD 1 TO WS-NUM-ADJS
                    MOVE FUNCTION TRIM(ADJ-RECORD) TO ADJ-ITEM(WS-NUM-ADJS)
                END-IF
        END-READ
    END-PERFORM
    CLOSE ADJ-IN-FILE

    IF WS-NUM-ADJS = 0
        DISPLAY "No adjectives loaded from: " FUNCTION TRIM(WS-ADJ-FILE) UPON SYSERR
        STOP RUN RETURNING 1
    END-IF

    MOVE 'N' TO WS-EOF
    MOVE 0 TO WS-NUM-NOUNS

    OPEN INPUT NOUN-IN-FILE
    IF WS-NOUN-STATUS NOT = "00"
        DISPLAY "Error opening noun file: " FUNCTION TRIM(WS-NOUN-FILE) UPON SYSERR
        STOP RUN RETURNING 1
    END-IF

    PERFORM UNTIL WS-EOF = 'Y' OR WS-NUM-NOUNS >= 40000
        READ NOUN-IN-FILE
            AT END
                MOVE 'Y' TO WS-EOF
            NOT AT END
                IF NOUN-RECORD NOT = SPACES
                    ADD 1 TO WS-NUM-NOUNS
                    MOVE FUNCTION LOWER-CASE(FUNCTION TRIM(NOUN-RECORD)) TO NOUN-ITEM(WS-NUM-NOUNS)
                END-IF
        END-READ
    END-PERFORM
    CLOSE NOUN-IN-FILE

    IF WS-NUM-NOUNS = 0
        DISPLAY "No nouns loaded from: " FUNCTION TRIM(WS-NOUN-FILE) UPON SYSERR
        STOP RUN RETURNING 1
    END-IF
    .

GENERATE-NAMES.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-COUNTO
        COMPUTE WS-ADJ-IDX = 1 + FUNCTION INTEGER-PART(FUNCTION RANDOM * WS-NUM-ADJS)
        IF WS-ADJ-IDX > WS-NUM-ADJS
            MOVE WS-NUM-ADJS TO WS-ADJ-IDX
        END-IF

        COMPUTE WS-NOUN-IDX = 1 + FUNCTION INTEGER-PART(FUNCTION RANDOM * WS-NUM-NOUNS)
        IF WS-NOUN-IDX > WS-NUM-NOUNS
            MOVE WS-NUM-NOUNS TO WS-NOUN-IDX
        END-IF

        IF FUNCTION TRIM(WS-DEBUG-STR) = "true"
            COMPUTE WS-I-MINUS-ONE = WS-I - 1
            DISPLAY FUNCTION TRIM(ADJ-ITEM(WS-ADJ-IDX)) UPON SYSERR
            DISPLAY FUNCTION TRIM(NOUN-ITEM(WS-NOUN-IDX)) UPON SYSERR
            DISPLAY FUNCTION TRIM(WS-ADJ-FILE) UPON SYSERR
            DISPLAY FUNCTION TRIM(WS-ADJ-FOLDER) UPON SYSERR
            DISPLAY FUNCTION TRIM(WS-NOUN-FILE) UPON SYSERR
            DISPLAY FUNCTION TRIM(WS-NOUN-FOLDER) UPON SYSERR
            DISPLAY FUNCTION NUMVAL(WS-I-MINUS-ONE) " > " FUNCTION NUMVAL(WS-COUNTO) UPON SYSERR
        END-IF

        MOVE SPACES TO WS-OUTPUT-LINE
        STRING FUNCTION TRIM(ADJ-ITEM(WS-ADJ-IDX)) DELIMITED BY SIZE
               FUNCTION TRIM(WS-SEPARATOR) DELIMITED BY SIZE
               FUNCTION TRIM(NOUN-ITEM(WS-NOUN-IDX)) DELIMITED BY SIZE
               INTO WS-OUTPUT-LINE
        DISPLAY FUNCTION TRIM(WS-OUTPUT-LINE)
    END-PERFORM
    .
